    {
      "name": "4 - Rotas de leiloeiro",
      "description": "Execute na ordem para criar leilão e lote. As variáveis auctionId e lotId são preenchidas automaticamente.",
      "item": [
        {
          "name": "Criar leilão",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auctioneerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Leilão de teste\",\n  \"description\": \"Criado pela coleção Postman\",\n  \"startsAt\": \"{{auctionStartsAt}}\",\n  \"endsAt\": \"{{auctionEndsAt}}\",\n  \"status\": \"ACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auctions"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = new Date();",
                  "pm.collectionVariables.set('auctionStartsAt', new Date(now.getTime() - 60 * 60 * 1000).toISOString());",
                  "pm.collectionVariables.set('auctionEndsAt', new Date(now.getTime() + 24 * 60 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  pm.collectionVariables.set('auctionId', pm.response.json().createAuction.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar meus leilões",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auctioneerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/auctions/mine"
          }
        },
        {
          "name": "Buscar leilão por ID (público)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/auctions/{{auctionId}}"
          }
        },
        {
          "name": "Buscar meu leilão por ID",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/auctions/{{auctionId}}"
          }
        },
        {
          "name": "Atualizar meu leilão",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auctioneerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Leilão atualizado pelo Postman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auctions/{{auctionId}}"
          }
        },
        {
          "name": "Tentar alterar leilão de outro leiloeiro (esperado: 404)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{otherAuctioneerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Não deve ser alterado\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auctions/{{auctionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Outro leiloeiro recebe 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar lote no meu leilão",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auctioneerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auctionId\": \"{{auctionId}}\",\n  \"title\": \"Lote de teste\",\n  \"description\": \"Criado pela coleção Postman\",\n  \"startingBid\": 100,\n  \"minimumIncrement\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/lots"
          },
          "event": [
            {
