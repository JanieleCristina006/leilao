  "item": [
    {
      "name": "1 - Cadastro público",
      "description": "Execute uma vez para criar as contas. Se executar novamente, altere os e-mails nas variáveis da coleção para evitar conflito de e-mail duplicado.",
      "item": [
        {
          "name": "Cadastrar licitante",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{bidderName}}\",\n  \"email\": \"{{bidderEmail}}\",\n  \"password\": \"{{bidderPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  pm.collectionVariables.set('bidderId', pm.response.json().createUser.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar segundo licitante",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{bidder2Name}}\",\n  \"email\": \"{{bidder2Email}}\",\n  \"password\": \"{{bidder2Password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  pm.collectionVariables.set('bidder2Id', pm.response.json().createUser.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar leiloeiro",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{auctioneerName}}\",\n  \"email\": \"{{auctioneerEmail}}\",\n  \"password\": \"{{auctioneerPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
