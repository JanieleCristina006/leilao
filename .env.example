# Gere um segredo aleatório antes de executar a aplicação:
# node -e "console.log(require('node:crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# DATABASE_URL é usada pela aplicação em tempo de execução.
# DIRECT_URL é usada pelos comandos do Prisma CLI.
# Ajuste usuário, senha e nome da base conforme seu PostgreSQL local.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verzel_leiloes?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/verzel_leiloes?schema=public

# Porta HTTP (opcional; padrão: 3000)
PORT=3000

# E-mail enviado no User-Agent das consultas ao Art Institute of Chicago
AIC_USER_EMAIL=desenvolvedor@example.com

# Origem permitida para o WebSocket do frontend.
# Várias origens podem ser separadas por vírgula.
FRONTEND_ORIGIN=http://localhost:5173
